# DataLens AI - Backend Production Environment Variables Example

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000

# LLM Providers Configuration
GEMINI_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-...
DEFAULT_LLM_PROVIDER=google  # 'google' or 'openai'
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Storage
TEMP_UPLOAD_DIR=/tmp/datalens_temp_uploads
